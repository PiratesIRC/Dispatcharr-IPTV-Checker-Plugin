# The vendored notification client is hash-pinned by
# scripts/client_manifest.json and must stay byte-identical to the canonical
# copy at ../_shared/notify_client.py. Pin it to LF: a CRLF copy normalises
# back on a Linux checkout, stops matching its pin, and fails CI for a reason
# that has nothing to do with the code.
iptv_checker/notify_client.py text eol=lf
# The vendored usage client is sha256-pinned the same way (scripts/client_manifest.json and
# tests/test_usage_client_parity.py), so it MUST stay LF on every OS.
iptv_checker/usage_client.py text eol=lf

# The vendored report page furniture is hash-pinned by
# scripts/chrome_manifest.json and must stay byte-identical to the canonical
# copy at ../_shared/report_chrome.py, which Stream-Mapparr also vendors. Same
# reasoning as above: a CRLF copy normalises back on a Linux checkout and stops
# matching its pin.
iptv_checker/report_chrome.py text eol=lf
.githooks/* text eol=lf
# The vendored storage layer is sha256-pinned by scripts/storage_manifest.json
# (tests/test_storage_parity.py), so it MUST stay LF on every OS.
iptv_checker/plugin_storage.py text eol=lf
# The release tools are sha256-pinned by scripts/tools_manifest.json, so they
# MUST stay LF on every OS. A CRLF copy changes the hash of the pinned file.
scripts/release_config.py text eol=lf
scripts/bump_version.py text eol=lf
scripts/check_version_sync.py text eol=lf
scripts/validate_zip.py text eol=lf
scripts/build_release_zip.py text eol=lf
