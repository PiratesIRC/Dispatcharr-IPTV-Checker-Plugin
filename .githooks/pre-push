#!/usr/bin/env bash
# Audit whatever is about to be pushed, before it leaves this machine.
#
# The hook reads the refs git is about to send on stdin and audits each one.
# It is a real gate, not a reminder: a non-zero audit aborts the push.
#
# WHY THIS REPOSITORY NEEDS IT PARTICULARLY. The remote is PUBLIC (measured
# 2026-08-05: public, 50 stars, 4 forks) and main is pushed to it DIRECTLY,
# with no orphan branch in between. There is no staging step and no second
# chance: everything reachable from a pushed ref is world-readable the moment
# the push completes, and with forks in existence a history rewrite cannot
# take it back. Nothing else on this machine stops a bad push.
#
# To push anyway, having read every finding:  git push --no-verify
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
AUDIT="$ROOT/../.claude/skills/pre-publish-audit/audit_publish.py"
RULES="$ROOT/.publish-audit.json"
PY="${PYTHON:-python}"; command -v "$PY" >/dev/null 2>&1 || PY=python3

# git passes the remote name as $1 and its URL as $2.
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

if [ ! -f "$AUDIT" ]; then
  echo "[pre-push] publish audit not found at $AUDIT"
  echo "[pre-push] refusing to push blind. Restore it, or use --no-verify if you have read the tree yourself."
  exit 1
fi

# A PRIVATE remote may legitimately receive the development history and design
# documents. The allowance is an explicit list in .publish-audit.json, matched
# against the remote URL, so the default stays deny: an unrecognised remote is
# audited.
#
# THIS REPOSITORY HAS NO SUCH REMOTE, and private_remotes is deliberately
# empty. origin is a PUBLIC publication target. Do NOT add origin to that list
# to silence a finding.
if [ -f "$RULES" ] && [ -n "$REMOTE_URL" ]; then
  if "$PY" - "$RULES" "$REMOTE_URL" <<'PYEOF'
import json, re, sys
rules = json.load(open(sys.argv[1], encoding="utf-8"))
url = sys.argv[2]
for entry in rules.get("private_remotes", []):
    if re.search(entry["pattern"], url):
        print("[pre-push] " + entry["why"])
        sys.exit(0)
sys.exit(1)
PYEOF
  then
    echo "[pre-push] $REMOTE_NAME is a private remote: content audit skipped by an explicit rule."
    exit 0
  fi
fi

status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # An all-zero local sha means a branch deletion. Nothing is published by it.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  echo "[pre-push] auditing $local_sha"
  if [ -f "$RULES" ]; then
    "$PY" "$AUDIT" --ref "$local_sha" --rules "$RULES" --repo "$ROOT" || status=1
  else
    echo "[pre-push] no .publish-audit.json in this repository: running with built-in patterns only."
    echo "[pre-push] the repository-specific deny list is the half that catches real leaks here."
    "$PY" "$AUDIT" --ref "$local_sha" --repo "$ROOT" || status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo
  echo "[pre-push] PUSH ABORTED. Read every finding above."
  echo "[pre-push] If a finding is expected, add it to .publish-audit.json with a reason."
  echo "[pre-push] If a credential really is in there, ROTATE IT FIRST: publishing cannot be undone."
  exit 1
fi

echo "[pre-push] audit clean"
exit 0
